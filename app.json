{
  "expo": {
    "name": "Spotter",
    "slug": "spotter",
    "version": "1.7.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yeager.spotter",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yeager.spotter",
      "versionCode": 11,
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_BODY_WATER_MASS",
        "android.permission.health.READ_BONE_MASS",
        "android.permission.health.READ_BASAL_METABOLIC_RATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0B",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Spotter uses the photos and clips you choose for your profile picture, progress photos and your own exercises.",
          "cameraPermission": "Spotter uses the camera when you take a progress photo at a check-in.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Spotter saves your recap and session cards to your photos.",
          "savePhotosPermission": "Spotter saves your recap and session cards to your photos.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/michroma/400Regular/Michroma_400Regular.ttf",
            "./node_modules/@expo-google-fonts/manrope/500Medium/Manrope_500Medium.ttf",
            "./node_modules/@expo-google-fonts/manrope/700Bold/Manrope_700Bold.ttf",
            "./node_modules/@expo-google-fonts/manrope/800ExtraBold/Manrope_800ExtraBold.ttf"
          ],
          "widgets": [
            {
              "name": "Today",
              "label": "Today",
              "description": "Today’s session and your week.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/today.png"
            },
            {
              "name": "Month",
              "label": "Month",
              "description": "Sessions this month, best lift and new bests.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 3600000,
              "previewImage": "./assets/widgets/month.png"
            },
            {
              "name": "BestLift",
              "label": "Best lift",
              "description": "One lift, its best and its last six sessions.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable",
              "previewImage": "./assets/widgets/bestlift.png"
            },
            {
              "name": "Body",
              "label": "Body",
              "description": "Your last check-in.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/body.png"
            },
            {
              "name": "Start",
              "label": "Start",
              "description": "Start today’s session in one tap.",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widgets/start.png"
            },
            {
              "name": "Me",
              "label": "Me",
              "description": "Your month around your photo.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 3600000,
              "previewImage": "./assets/widgets/me.png"
            },
            {
              "name": "MeSmall",
              "label": "Me (small)",
              "description": "Your photo and this month’s sessions.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 3600000,
              "previewImage": "./assets/widgets/mesmall.png"
            }
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E70B16",
          "sounds": [
            "./assets/sounds/rest_done.wav"
          ],
          "enableRemoteNotifications": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-asset",
      "expo-background-task",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.yeager.spotter",
          "widgets": [
            {
              "name": "Today",
              "displayName": "Today",
              "description": "Today’s session and your week.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium",
                  "systemLarge"
                ],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "Month",
              "displayName": "Month",
              "description": "Sessions this month, best lift and new bests.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium",
                  "systemLarge"
                ],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "BestLift",
              "displayName": "Best lift",
              "description": "One lift, its best and its last six sessions.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "contentMarginsDisabled": true,
                "configuration": {
                  "title": "Best lift",
                  "description": "Pick the lift it shows.",
                  "parameters": {
                    "lift": {
                      "title": "Lift",
                      "type": "enum",
                      "default": "top",
                      "values": [
                        {
                          "name": "Heaviest lift",
                          "value": "top"
                        }
                      ],
                      "dynamic": true
                    }
                  }
                }
              }
            },
            {
              "name": "Body",
              "displayName": "Body",
              "description": "Your last check-in.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "Start",
              "displayName": "Start",
              "description": "Start today’s session in one tap.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "accessoryCircular"
                ],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "Me",
              "displayName": "Me",
              "description": "Your month around your photo.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium",
                  "systemLarge"
                ],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "MeSmall",
              "displayName": "Me (small)",
              "description": "Your photo and this month’s sessions.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall"
                ],
                "contentMarginsDisabled": true
              }
            }
          ]
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Spotter reads your latest weigh-in (weight, body fat and energy burned at rest) when you tap Fill from Apple Health on a check-in. Nothing is written back.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ]
    ],
    "scheme": "spotter",
    "backgroundColor": "#0B0B0B",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "1fbf4159-0b8f-486b-859e-cdc99177f3d5"
      }
    },
    "owner": "yeagx"
  }
}
